{
  "name": "culture-clash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "content": "node scripts/build-statements.ts",
    "predev": "npm run content",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "dev:api": "wrangler pages dev public --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply culture-clash --local",
    "metrics:local": "wrangler d1 execute culture-clash --local --file scripts/metrics.sql",
    "metrics": "wrangler d1 execute culture-clash --remote --file scripts/metrics.sql"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/realtime-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
